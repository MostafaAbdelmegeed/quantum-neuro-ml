{
  "version": "abide-signed-graph-v4",
  "representations": [
    "raw",
    "residual"
  ],
  "nodes": 200,
  "spectral_dimensions": 8,
  "node_features": "training_standardized_connectivity_profiles_plus_per_graph_absolute_laplacian_eigenvectors",
